{
  "name": "openchainclaw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "description": "Transparent local-first AI assistant prototype with verifiable audit logs.",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "pnpm build && node --env-file-if-exists=.env dist/src/server.js",
    "test": "pnpm build && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-agent",
    "audit-log",
    "local-first",
    "web3"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "posthog-node": "^5.30.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
